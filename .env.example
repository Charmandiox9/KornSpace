# Token personal de LocalStack: https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# OAuth de Google, JWT de acceso y sesión en Redis.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/auth/google/callback
FRONTEND_ORIGIN=http://localhost:3001
# Destino del proxy de API en el servidor Next.js. Compose lo reemplaza por http://backend:3000.
API_PROXY_TARGET=http://localhost:3000
# Origen WebSocket directo opcional. Déjalo vacío para detección automática
# (Next :3001 -> Nest :3000 en desarrollo; mismo origen detrás de Nginx).
NEXT_PUBLIC_API_WS_URL=
# Genera con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false

# URL agrupada de Neon para las consultas normales del backend.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# URL directa de Neon para las migraciones de Prisma (sin el sufijo -pooler).
# Para PostgreSQL local o autogestionado, puede ser igual a DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR_NEON_HOST.REGION.aws.neon.tech/DB?sslmode=require

# Usados por docker-compose.production.yml para la base PostgreSQL en Docker.
POSTGRES_USER=kornspace
POSTGRES_DB=kornspace
POSTGRES_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO
POSTGRES_DATABASE_URL=postgresql://kornspace:CAMBIAR_POR_UN_SECRETO_LARGO@postgres:5432/kornspace?schema=public

# PostgreSQL local con el servicio ya definido en docker-compose.production.yml:
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.production.yml
# DATABASE_URL=postgresql://kornspace:TU_PASSWORD@localhost:5432/kornspace?schema=public
# DATABASE_URL_UNPOOLED=postgresql://kornspace:TU_PASSWORD@localhost:5432/kornspace?schema=public
# POSTGRES_DATABASE_URL usa el mismo usuario/contraseña y el host postgres dentro de Docker.
POSTGRES_PORT=5432
# Conserva opcionalmente las conexiones originales en el mismo .env para volver a Neon:
# NEON_DATABASE_URL=
# NEON_DATABASE_URL_UNPOOLED=

# Conexiones elegidas por pnpm db:use local|neon para el overlay de Docker.
# Vacías usan POSTGRES_DATABASE_URL (PostgreSQL local).
DOCKER_DATABASE_URL=
DOCKER_DATABASE_URL_UNPOOLED=
# Origen fijo opcional del sincronizador, independiente de la base activa:
# LOCAL_DATABASE_URL=postgresql://kornspace:TU_PASSWORD@localhost:5432/kornspace?schema=public
