# Token personal de LocalStack: https://app.localstack.cloud
LOCALSTACK_AUTH_TOKEN=

# URL agrupada de Neon para las consultas normales del backend.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# URL directa de Neon para las migraciones de Prisma (sin el sufijo -pooler).
# Para PostgreSQL local o autogestionado, puede ser igual a DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR_NEON_HOST.REGION.aws.neon.tech/DB?sslmode=require

# Usados por docker-compose.production.yml para la base PostgreSQL en Docker.
POSTGRES_USER=kornspace
POSTGRES_DB=kornspace
POSTGRES_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO
POSTGRES_DATABASE_URL=postgresql://kornspace:CAMBIAR_POR_UN_SECRETO_LARGO@postgres:5432/kornspace?schema=public
