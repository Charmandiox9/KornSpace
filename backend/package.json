{
  "name": "kornspace-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm start:dev",
    "build": "node scripts/prisma-with-root-env.cjs generate && nest build",
    "start": "nest start",
    "start:dev": "node --env-file=../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "node scripts/prisma-with-root-env.cjs generate",
    "prisma:migrate:dev": "node scripts/prisma-with-root-env.cjs migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-with-root-env.cjs migrate deploy",
    "prisma:migrate:status": "node scripts/prisma-with-root-env.cjs migrate status",
    "test:compile": "tsc --module commonjs --target ES2022 --strict --esModuleInterop --emitDecoratorMetadata --experimentalDecorators --skipLibCheck --rootDir . --outDir .test-dist test/health.e2e-spec.ts test/prisma.service.spec.ts test/files.service.spec.ts test/files.e2e-spec.ts test/folders.service.spec.ts test/move-resource.spec.ts test/folders.e2e-spec.ts test/auth.guard.spec.ts test/auth.e2e-spec.ts test/auth.flow.spec.ts test/managed-uploads.spec.ts test/managed-uploads.e2e-spec.ts test/file-operations.e2e-spec.ts test/preferences.spec.ts test/preferences.e2e-spec.ts",
    "test:unit": "pnpm test:compile && node --test .test-dist/test/preferences.spec.js .test-dist/test/prisma.service.spec.js .test-dist/test/files.service.spec.js .test-dist/test/folders.service.spec.js .test-dist/test/auth.flow.spec.js .test-dist/test/managed-uploads.spec.js",
    "test:e2e": "pnpm test:compile && node --test .test-dist/test/preferences.e2e-spec.js .test-dist/test/health.e2e-spec.js .test-dist/test/files.e2e-spec.js .test-dist/test/folders.e2e-spec.js .test-dist/test/move-resource.spec.js .test-dist/test/auth.e2e-spec.js .test-dist/test/managed-uploads.e2e-spec.js .test-dist/test/file-operations.e2e-spec.js",
    "test": "pnpm test:compile && node --test .test-dist/test/preferences.e2e-spec.js .test-dist/test/preferences.spec.js .test-dist/test/prisma.service.spec.js .test-dist/test/files.service.spec.js .test-dist/test/folders.service.spec.js .test-dist/test/move-resource.spec.js .test-dist/test/health.e2e-spec.js .test-dist/test/files.e2e-spec.js .test-dist/test/folders.e2e-spec.js .test-dist/test/auth.guard.spec.js .test-dist/test/auth.e2e-spec.js .test-dist/test/auth.flow.spec.js .test-dist/test/managed-uploads.spec.js .test-dist/test/managed-uploads.e2e-spec.js .test-dist/test/file-operations.e2e-spec.js"
  },
  "dependencies": {
    "@apollo/server": "^5",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^11.3.4",
    "graphql": "^17.1.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  }
}
