generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  googleSubject String       @unique
  email         String
  name          String?
  username      String?      @unique
  pictureUrl    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  files         StoredFile[]
  folders       Folder[]
  folderPermissions FolderPermission[]
  filePermissions FilePermission[]
  fileVisits FileVisit[]
}

enum FileStatus {
  PROCESSING
  AVAILABLE
  FAILED
}

model StoredFile {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  contentType String
  sizeBytes   BigInt
  s3Key       String     @unique
  checksum    String?
  status      FileStatus @default(PROCESSING)
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  deletionPending Boolean @default(false)
  permissions FilePermission[]
  visits FileVisit[]
  ownerId     String?    @db.Uuid
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  folderId    String?    @db.Uuid
  folder      Folder?    @relation(fields: [folderId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@index([ownerId, createdAt])
  @@index([ownerId, deletedAt])
  @@index([folderId, ownerId])
  @@index([deletionPending, deletedAt])
}

model Folder {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  ownerId   String       @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  parentId  String?      @db.Uuid
  parent    Folder?      @relation("FolderTree", fields: [parentId, ownerId], references: [id, ownerId], onDelete: Restrict)
  permissions FolderPermission[]
  children  Folder[]     @relation("FolderTree")
  files     StoredFile[]

  @@unique([id, ownerId])
  @@unique([ownerId, parentId, name])
  @@index([ownerId, parentId])
  @@index([ownerId, createdAt])
}

enum FileRole {
  READER
  EDITOR
}

model FilePermission {
  fileId String @db.Uuid
  userId String @db.Uuid
  role FileRole
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([fileId, userId])
  @@index([userId, fileId])
}

model FileVisit {
  fileId String @db.Uuid
  userId String @db.Uuid
  openedAt DateTime @default(now())
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([fileId, userId])
  @@index([userId, openedAt])
}

model FolderPermission {
  role FileRole @default(EDITOR)
  folderId String @db.Uuid
  userId String @db.Uuid
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([folderId, userId])
  @@index([userId, folderId])
}
