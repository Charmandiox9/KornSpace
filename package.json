{
  "name": "kornspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev:frontend": "pnpm --filter kornspace-frontend dev",
    "dev:backend": "pnpm --filter kornspace-backend start:dev",
    "prisma:generate": "pnpm --filter kornspace-backend prisma:generate",
    "prisma:migrate:dev": "pnpm --filter kornspace-backend prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter kornspace-backend prisma:migrate:deploy",
    "prisma:migrate:status": "pnpm --filter kornspace-backend prisma:migrate:status",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "@graphql-tools/utils": "12.1.0",
      "multer": "2.5.0",
      "js-yaml": "5.4.1"
    }
  }
}
